---
import ArrowUpRightFromSquare from "../assets/arrow-up-right-from-square.svg"
import DiscordSymbolWhite from "../assets/Discord-Symbol-White.svg"
import GithubMark from "../assets/mark-github-24.svg"
---

<nav class="bg-zinc-900 fixed w-screen max-w-full z-20 top-0 start-0">
    <div
        class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4"
    >
        <a
            class="text-2xl font-medium text-white hover:text-indigo-700"
            href="/"
        >
            packetevents
        </a>

        <div class="flex md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse">
            <div class="gap-3 mr-5 hidden md:flex items-center">
                <a href="https://discord.gg/DVHxPPxHZc" target="_">
                    <DiscordSymbolWhite aria-label="Discord" class="w-7 cursor-pointer"/>
                </a>
                <a href="https://github.com/retrooper/packetevents" target="_">
                    <GithubMark aria-label="GitHub" class="w-7 cursor-pointer"/>
                </a>
            </div>
            <a
                href="https://docs.packetevents.com/getting-started"
                target="_"
                class="hidden xs:block text-white bg-indigo-800 hover:bg-indigo-700 font-medium rounded-lg text-sm px-4 py-2 text-center"
            >
                Get started
            </a>
            <button
                id="nav-toggle"
                type="button"
                class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-zinc-800 focus:outline-2 focus:outline-zinc-200"
                aria-controls="nav-menu"
                aria-expanded="false"
                aria-label="Open main menu"
            >
                <svg
                    class="w-5 h-5"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 17 14"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M1 1h15M1 7h15M1 13h15"
                    >
                    </path>
                </svg>
            </button>
        </div>

        <div
            id="nav-menu"
            class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
        >
            <ul
                class="flex flex-col p-4 mt-4 font-medium rounded-lg bg-zinc-800 md:space-x-8 md:flex-row md:mt-0 md:bg-zinc-900"
            >
                <li class="flex items-center group cursor-pointer">
                    <a
                        href="https://docs.packetevents.com/"
                        target="_"
                        class="block py-2 px-3 text-white rounded hover:bg-zinc-900 md:hover:bg-transparent md:group-hover:text-indigo-700 md:p-0"
                    >
                        Docs
                    </a>
                    <ArrowUpRightFromSquare class="h-3.5 inline ml-2 group-hover:text-indigo-700" aria-hidden/>
                </li>
                <li class="flex items-center group cursor-pointer">
                    <a
                        href="https://github.com/retrooper/packetevents-example"
                        target="_"
                        class="block py-2 px-3 text-white rounded hover:bg-zinc-900 md:hover:bg-transparent md:group-hover:text-indigo-700 md:p-0"
                    >
                        Examples
                    </a>
                    <ArrowUpRightFromSquare class="h-3.5 inline ml-2 group-hover:text-indigo-700" aria-hidden/>
                </li>
                <li>
                    <a
                        href="/blog"
                        class="block py-2 px-3 text-white rounded hover:bg-zinc-900 md:hover:bg-transparent md:hover:text-indigo-700 md:p-0"
                    >
                        Blog
                    </a>
                </li>
                <li class="block xs:hidden w-full">
                    <a
                        href="https://docs.packetevents.com/getting-started"
                        target="_"
                        class="block w-full text-white bg-indigo-800 hover:bg-indigo-700 font-medium rounded-lg text-sm px-4 py-2 text-center"
                    >
                        Get started
                    </a>
                </li>
                <li class="md:hidden mt-2 flex justify-between gap-3">
                    <a
                        class="w-1/2 bg-zinc-900 px-3 py-2 rounded-lg flex items-center"
                        href="https://discord.gg/DVHxPPxHZc"
                        target="_"
                    >
                        <DiscordSymbolWhite aria-label="Discord" class="w-7 cursor-pointer mx-auto"/>
                    </a>
                    <a
                        class="w-1/2 bg-zinc-900 px-3 py-2 rounded-lg flex items-center"
                        href="https://github.com/retrooper/packetevents"
                        target="_"
                    >
                        <GithubMark aria-label="GitHub" class="w-7 cursor-pointer mx-auto"/>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");
    toggle?.addEventListener("click", () => {
        menu?.classList.toggle("hidden");
    });
</script>
