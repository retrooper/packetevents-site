---
import {bstatsPluginId} from "../scripts/bstats.ts";

type LinkEntry = { title: string, links: Record<string, string> }

const links: LinkEntry[] = [
    {
        title: "Resources",
        links: {
            "Docs": "https://docs.packetevents.com/",
            "Getting started": "https://docs.packetevents.com/getting-started",
            "Javadocs": "https://javadocs.packetevents.com/",
            "Statistics": `https://bstats.org/plugin/bukkit/packetevents/${bstatsPluginId}`,
        },
    },
    {
        title: "Help Center",
        links: {
            "Discord Server": "https://discord.gg/DVHxPPxHZc",
            "Contact Us": "mailto:retrooper@packetevents.com",
        },
    },
];
---

<footer class="bg-white/10 w-full flex justify-center items-center pt-10 mt-10 pb-5 px-5">
    <div class="w-full max-w-7xl flex flex-col gap-5">
        <div class="w-full flex flex-row flex-wrap justify-center not-xs:items-center gap-10">
            {links.map(({title, links}) => (
                <div class="flex flex-col gap-0.5">
                    <p class="font-medium text-lg select-none">{title}</p>
                    {Object.entries(links).map(([name, href]) => (
                        <a href={href} target="_blank" class="opacity-80 hover:opacity-60">{name}</a>
                    ))}
                </div>
            ))}
        </div>
        <div class="flex flex-col gap-2 items-center select-none text-center">
            <p>&copy; {new Date().getUTCFullYear()} packetevents contributors, made with {Astro.generator}</p>
            <p class="opacity-80 text-sm">
                NOT AN OFFICIAL MINECRAFT PRODUCT.<br/>
                NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.
            </p>
        </div>
    </div>
</footer>
