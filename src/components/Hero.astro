---
---

<section>
    <div class="px-5 w-full flex justify-center bg-zinc-900">
        <div
            class="w-full max-w-4xl text-center pt-40 items-center flex flex-col"
        >
            <div class="rounded-full border border-zinc-600 w-fit px-3 py-2">
                <p class="text-zinc-300">
                    Powering over <span class="text-white">40,000</span> servers
                </p>
            </div>

            <p class="mt-10 text-white text-4xl font-medium">
                Powerful, Versatile
            </p>
            <p
                class="mt-5 text-indigo-700 text-3xl xs:text-5xl md:text-6xl font-bold"
            >
                PacketEvents
            </p>
            <p class="mt-2 text-zinc-300 font-medium">
                Achieve next-level networking.
            </p>

            <div
                class="mt-10 flex flex-col xs:flex-row gap-2 md:gap-10 items-center"
            >
                <a
                    href="https://modrinth.com/plugin/packetevents"
                    target="_"
                    class="w-full xs:w-fit"
                >
                    <div
                        class="w-full text-white text-sm font-medium rounded-lg bg-zinc-700 hover:bg-zinc-800 px-5 py-3 cursor-pointer"
                    >
                        Downloads
                    </div>
                </a>

                <a
                    href="https://docs.packetevents.com/getting-started"
                    target="_"
                    class="w-full xs:w-fit"
                >
                    <div
                        class="text-white border rounded-lg px-5 py-3 border-zinc-600 hover:bg-zinc-600 cursor-pointer"
                    >
                        Getting started
                    </div>
                </a>

                <a href="/faq" class="w-full xs:w-fit">
                    <div
                        class="text-white border rounded-lg px-5 py-3 border-zinc-600 hover:bg-zinc-600 cursor-pointer"
                    >
                        FAQ
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
