---
import LinkButton from "./common/LinkButton.astro";
import {playerCount, serverCount} from "../scripts/bstats.ts";
---

<header class="w-full flex justify-center">
    <div class="w-full max-w-4xl text-center items-center flex flex-col">
        <h1 class="text-white text-4xl font-medium">Powerful, Versatile</h1>
        <h2 class="mt-5 text-primary text-3xl xs:text-5xl md:text-6xl font-bold">
            packetevents
        </h2>
        <h3 class="mt-2 text-zinc-300 font-medium">
            Achieve next-level networking.
        </h3>

        <p class="mt-5 rounded-full border border-white/60 w-fit px-3 py-2 select-none text-white/80">
            Powering over <span class="text-white">{playerCount}</span> players
            <span class="not-xs:hidden"> on <span class="text-white">{serverCount}</span> servers</span>
        </p>

        <div class="mt-5 flex flex-col xs:flex-row gap-2 xs:items-center">
            <LinkButton
                href="https://modrinth.com/plugin/packetevents"
                color="gray" external
                class="font-medium justify-center"
            >
                Downloads
            </LinkButton>
            <LinkButton
                href="https://docs.packetevents.com/getting-started"
                color="gray" external
                class="font-medium justify-center"
            >
                Getting started
            </LinkButton>
            <LinkButton href="/faq" color="gray" class="font-medium justify-center">
                FAQ
            </LinkButton>
        </div>
    </div>
</header>
