---
import DownwardArrow from "../assets/downward-arrow.svg";
import {getCollection, render} from "astro:content";

const entries = (await getCollection("faq")).sort((a, b) =>
    a.data.question.localeCompare(b.data.question));
const rendered = await Promise.all(entries.map(async (entry) =>
    ({entry, Content: (await render(entry)).Content})));
---

<div class="px-5 w-full flex justify-center">
    <div class="w-full max-w-4xl text-left">

        {rendered.map(({entry, Content}) => (
            <details class="border-b border-b-primary-dark group" name="faq" id={entry.id}>
                <summary
                    class="list-none cursor-pointer flex items-center justify-between w-full p-5 font-medium hover:bg-white/10 gap-3 rounded-lg"
                >
                    <span class="text-lg">{entry.data.question}</span>
                    <DownwardArrow
                        class="w-3 h-3 not-group-open:rotate-180 group-open:rotate-0 transition-transform"
                        aria-hidden="true"
                    />
                </summary>
                <div class="p-5 opacity-90 blog-content">
                    <Content/>
                </div>
            </details>
        ))}
    </div>
</div>
