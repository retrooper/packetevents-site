---
import {playerCount, serverCount} from "../scripts/bstats.ts";

const features = [
    {
        title: "Free & Open Source",
        subtitle: "Respects your freedom",
        detail: "Transparent development",
    },
    {
        title: "Active Community",
        subtitle: "Collaborative user base",
        detail: "Active knowledge exchange",
    },
    {
        title: "Rich Features",
        subtitle: "Focus on convenience",
        detail: "Intuitive integration",
    },
    {
        title: "Portable",
        subtitle: "Write once, run anywhere",
        detail: "Cross-platform",
    },
    {
        title: "Ubiquitous",
        subtitle: `Powering over ${playerCount} players`,
        detail: `Running on over ${serverCount} servers`,
    },
    {
        title: "Innovative",
        subtitle: "Modern approach",
        detail: "Different approach",
    },
];
---

<section class="w-full flex items-center justify-center">
    <div class="max-w-5xl w-full pt-10 grid gap-5 md:gap-10 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {
            features.map((f) => (
                <div class="bg-white/10 p-5 md:p-10 rounded-lg w-full text-white">
                    <p class="text-lg font-medium">{f.title}</p>
                    <p class="text-white/80">{f.subtitle}</p>
                    <p class="mt-2 text-sm">{f.detail}</p>
                </div>
            ))
        }
    </div>
</section>
