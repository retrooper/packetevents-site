---
const features = [
    {
        title: "Free & Open Source",
        subtitle: "Respects your freedom",
        detail: "Transparent development",
    },
    {
        title: "Active Community",
        subtitle: "Collaborative user base",
        detail: "Active knowledge exchange",
    },
    {
        title: "Rich Features",
        subtitle: "Focus on convenience",
        detail: "Intuitive integration",
    },
    {
        title: "Portable",
        subtitle: "Write once, run anywhere",
        detail: "Cross-platform",
    },
    {
        title: "Ubiquitous",
        subtitle: "Powering over 170,000 players",
        detail: "Running on over 40,000 servers",
    },
    {
        title: "Innovative",
        subtitle: "Modern approach",
        detail: "Different approach",
    },
];
---

<div class="w-full bg-zinc-900 flex justify-center pt-10 md:pt-32">
    <div class="flex-col gap-5 hidden md:flex">
        <div class="w-full max-w-4xl flex justify-center gap-5">
            {
                features.slice(0, 3).map((f) => (
                    <div class="bg-zinc-800 p-10 rounded-lg w-72">
                        <p class="text-white text-lg font-medium">{f.title}</p>
                        <p class="text-zinc-300">{f.subtitle}</p>
                        <p class="mt-5 text-sm text-white">{f.detail}</p>
                    </div>
                ))
            }
        </div>

        <div class="w-full max-w-4xl flex justify-center gap-5">
            {
                features.slice(3, 6).map((f) => (
                    <div class="bg-zinc-800 p-10 rounded-lg w-72">
                        <p class="text-white text-lg font-medium">{f.title}</p>
                        <p class="text-zinc-300">{f.subtitle}</p>
                        <p class="mt-5 text-sm text-white">{f.detail}</p>
                    </div>
                ))
            }
        </div>
    </div>
</div>

<div class="md:hidden overflow-x-auto flex gap-5 p-5 bg-zinc-900 snap-x snap-mandatory">
    {
        features.map((f) => (
            <div class="bg-zinc-800 p-10 rounded-lg w-72 shrink-0 snap-center">
                <p class="text-white text-lg font-medium">{f.title}</p>
                <p class="text-zinc-300">{f.subtitle}</p>
                <p class="mt-5 text-sm text-white">{f.detail}</p>
            </div>
        ))
    }
</div>
