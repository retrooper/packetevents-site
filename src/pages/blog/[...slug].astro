---
import {getCollection, render} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {formatDateWithSuffix} from "../../scripts/date";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: {slug: post.id},
        props: {post},
    }));
}

const {post} = Astro.props;
const {Content} = await render(post);
const formattedDate = formatDateWithSuffix(post.data.date);
---

<BaseLayout title={`PacketEvents - ${post.data.title}`}>
    <section class="w-full pt-20 xs:pt-40">
        <div class="md:mx-auto max-w-4xl m-5">
            <a href="/blog">
                <p class="text-white">&lt; Back</p>
            </a>

            <br />
            <div class="mx-auto">
                <p class="text-zinc-300 text-center text-xs">{formattedDate}</p>
                <p
                    class="text-indigo-500 text-center font-medium text-2xl xs:text-4xl"
                >
                    {post.data.title}
                </p>

                <div class="blog-content mt-5 text-white">
                    <Content />
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
