---
import {getCollection, render} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {formatDateWithSuffix} from "../../scripts/date";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const rendered = await Promise.all(
    posts.map(async (post) => ({
        post,
        Content: (await render(post)).Content,
    })),
);
---

<BaseLayout title="PacketEvents - Blog">
    <section>
        <div
            class="w-full min-h-screen flex flex-col items-center mt-20 xs:mt-40"
        >
            <div class="w-full px-5 xs:px-10 max-w-screen-xl h-full">
                <p class="text-white text-lg xs:text-2xl font-medium">
                    Latest PacketEvents news
                </p>

                <div
                    class="grid grid-cols-1 md:grid-cols-3 mt-5 xs:mt-20 gap-5"
                >
                    {
                        rendered.map(({post, Content}) => (
                            <div class="border border-zinc-700 p-2 xs:p-10 rounded-xl flex flex-col justify-between">
                                <div>
                                    <p class="text-zinc-300 text-xs xs:text-md">
                                        {formatDateWithSuffix(post.data.date)}
                                    </p>
                                    <p class="text-indigo-500 font-medium xs:text-xl">
                                        {post.data.title}
                                    </p>
                                    <div class="blog-content mt-3">
                                        <Content />
                                    </div>
                                </div>
                                <a href={`/blog/${post.id}`}>
                                    <div class="w-full text-center bg-zinc-700 hover:bg-zinc-600 p-2 rounded-xl mt-5 bottom-0">
                                        <p class="text-white">Read More</p>
                                    </div>
                                </a>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
