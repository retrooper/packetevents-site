---
import {getCollection, render} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/common/Card.astro";
import Header from "../../components/common/Header.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const rendered = await Promise.all(posts.map(async (post) =>
    ({post, Content: (await render(post)).Content})));
---

<BaseLayout
    title="Blog"
    description="Latest packetevents release announcements and news about the Minecraft Java Edition protocol library."
>
    <section class="w-full flex justify-center">
        <div class="w-full max-w-6xl items-center flex flex-col gap-10">
            <Header>Latest packetevents news</Header>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                {rendered.map(({post, Content}) => (
                    <Card title={post.data.title} date={post.data.date} href={`/blog/${post.id}/`}>
                        {post.data.summary ??
                            <Content/>}
                    </Card>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>
