---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
---

<BaseLayout title="PacketEvents - FAQ">
    <section>
        <div class="min-h-screen mb-40 pb-48 bg-zinc-900 pt-40">
            <div
                class="text-zinc-100 mx-auto text-center text-2xl mb-10 font-medium"
            >
                <span>Frequently Asked Questions</span>
                <div class="w-full max-w-4xl mx-auto mt-5 h-1 bg-indigo-700"/>
            </div>
            <FaqAccordion />
        </div>
    </section>
</BaseLayout>
