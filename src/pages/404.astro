---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
    <section class="w-full flex flex-col justify-center items-center gap-5">
        <div class="flex flex-col">
            <h1 class="text-white text-7xl font-medium">Uh oh!</h1>
            <h2 class="text-primary-light text-xl">This page doesn't exist.</h2>
        </div>
        <a
            class="px-5 py-3 bg-primary hover:bg-primary/80 rounded-lg transition-colors"
            href="/"
        >
            Go Back
        </a>
    </section>
</BaseLayout>
