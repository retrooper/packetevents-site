---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkButton from "../components/common/LinkButton.astro";
---

<BaseLayout title="Page Not Found" noindex>
    <section class="w-full flex flex-col justify-center items-center gap-5">
        <div class="flex flex-col">
            <h1 class="text-white text-7xl font-medium">Uh oh!</h1>
            <h2 class="text-primary-light text-xl">This page doesn't exist.</h2>
        </div>
        <LinkButton href="/" color="primary">Go Back</LinkButton>
    </section>
</BaseLayout>
