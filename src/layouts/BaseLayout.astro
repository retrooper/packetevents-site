---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import ClientRouter from "astro/components/ClientRouter.astro";

interface Props {
    title?: string;
}

const {title: baseTitle} = Astro.props;
const title = baseTitle ? `packetevents - ${baseTitle}` : "packetevents";
---

<!doctype html>
<html lang="en" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <ClientRouter/>
    </head>
    <body class="font-sans flex flex-col min-h-screen bg-primary-dark text-white antialiased">
        <NavBar transition:persist />
        <main class="pt-16 px-10 w-full">
            <slot />
        </main>

        <div class="flex-1"/>
        <Footer transition:persist />
    </body>
</html>
